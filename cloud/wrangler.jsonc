{
  // Bob's durable state: one Durable Object per Bob project. Deploy with `wrangler deploy`, then
  // `wrangler secret put BOB_DURABLE_SECRET`. Local dev reads the secret from .dev.vars.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bob-durable",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "BOB_STATE", "class_name": "ProjectStateV2" },
      { "name": "BOB_DIRECTORY", "class_name": "DirectoryV2" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectState", "Directory"] },
    // v2 keys every object by the Bob instance's namespace in new, empty classes; v3 then deletes the v1 objects,
    // which Cloudflare allows only once no binding points at them.
    { "tag": "v2", "new_sqlite_classes": ["ProjectStateV2", "DirectoryV2"] },
    { "tag": "v3", "deleted_classes": ["ProjectState", "Directory"] }
  ],
  "observability": { "enabled": true }
}
