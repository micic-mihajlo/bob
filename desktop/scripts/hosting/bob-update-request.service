# Stages the newest release, or stops Bob, moves the staged release into place and starts Bob
# again, when an owner, an admin or a permitted member asks for it in Server Settings > Updates.
[Unit]
Description=Update Bob on request
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/Bob/hosted/bob-hosted-update request
# A download and an apply: the limits of bob-update.service and bob-update-apply.service.
TimeoutStartSec=45min
