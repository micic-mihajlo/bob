# Downloads and unpacks a newer Bob release next to the running one. bob-update.timer starts
# it; bob-update-apply.service moves the release into place at the next start of the server.
[Unit]
Description=Stage an Bob update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/Bob/hosted/bob-hosted-update stage
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
TimeoutStartSec=30min
