{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "knip.config.ts",
    "scripts/**/*.ts",
    "tools/vitest/**/*.ts",
    "src/backend/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/logging/src/**/*.ts"
  ],
  "exclude": [
    "scripts/agent-access-e2e.ts",
    "scripts/agent-hide-restore-e2e.ts",
    "scripts/bob-desktop-smoke.ts",
    "scripts/cline-free-models-e2e.ts",
    "scripts/desktop-notifications-e2e.ts",
    "scripts/nix-sources.ts"
  ]
}
